# ============================================
# FINTECH SCHEMA BUILDER - Variables específicas
# ============================================
# Copiar este archivo a .env y completar

# -------------------- OpenAI (opcional) --------------------
# Para features futuros de generación de descripciones automáticas
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -------------------- HTTP Client Config --------------------
# Timeout para fetches (segundos)
HTTP_TIMEOUT=15

# Intentos de retry
HTTP_MAX_RETRIES=3

# Duración del cache (minutos)
HTTP_CACHE_TTL=15

# -------------------- Schema Config --------------------
# Organización por defecto
DEFAULT_ORG_NAME=Naranja X

# URL base por defecto
DEFAULT_BASE_URL=https://www.naranjax.com

# -------------------- Streamlit --------------------
# Puerto del servidor Streamlit
STREAMLIT_PORT=8501

# Tema (opcional)
STREAMLIT_THEME=light
